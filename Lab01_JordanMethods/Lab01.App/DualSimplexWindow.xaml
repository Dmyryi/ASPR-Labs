<Window x:Class="Lab01.App.DualSimplexWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Lab01.App.Views"
        Title="Двоїста задача W — Lab01"
        Height="820" Width="1180" MinHeight="620" MinWidth="960"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource ContentScrim}">
    <Grid Margin="20">
        <Border Background="{StaticResource CardSurface}" BorderBrush="{StaticResource CardStroke}"
                BorderThickness="1" CornerRadius="18" Padding="20">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <views:SimplexView/>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
