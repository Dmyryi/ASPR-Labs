<Window x:Class="Lab01.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lab01.App"
        xmlns:vm="clr-namespace:Lab01.App.ViewModels"
        xmlns:views="clr-namespace:Lab01.App.Views"
        mc:Ignorable="d"
        Title="Lab01 — Jordan Methods" Height="820" Width="1240" MinHeight="640" MinWidth="980"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <ImageBrush x:Key="WindowBackground"
                    ImageSource="/Lab01.App;component/wmremove-transformed.png"
                    Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center"/>

        <DataTemplate DataType="{x:Type vm:InverseMatrixViewModel}">
            <views:InverseMatrixView DataContext="{Binding}"/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RankViewModel}">
            <views:RankView DataContext="{Binding}"/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LinearSystemViewModel}">
            <views:LinearSystemView DataContext="{Binding}"/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SimplexViewModel}">
            <views:SimplexView DataContext="{Binding}"/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:GomoryViewModel}">
            <views:GomoryView DataContext="{Binding}"/>
        </DataTemplate>
    </Window.Resources>

    
    <Grid Margin="20">
        <Grid.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="40" ShadowDepth="0" Opacity="0.55"/>
        </Grid.Effect>

        <Border x:Name="WindowBorder" CornerRadius="22" BorderThickness="0"
                Background="{StaticResource WindowBackground}" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                
                <Border Grid.Row="0" Padding="22,14" CornerRadius="22,22,0,0"
                        MouseLeftButtonDown="TopBar_OnMouseLeftButtonDown"
                        Background="{StaticResource TopBarScrim}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="38" Height="38" CornerRadius="11"
                                    Background="{StaticResource ButtonPrimary}" VerticalAlignment="Center">
                                <TextBlock Text="J" FontFamily="{StaticResource UiFont}" FontSize="20" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimary}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Jordan Methods" FontFamily="{StaticResource UiFont}"
                                           FontSize="15" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimary}"/>
                                <TextBlock Text="Лінійна алгебра • Симплекс" FontFamily="{StaticResource UiFont}"
                                           FontSize="11" Foreground="{StaticResource TextMuted}"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="MinimizeButton" Style="{StaticResource WindowChromeButton}"
                                    Click="MinimizeButton_OnClick" ToolTip="Згорнути">
                                <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="11"/>
                            </Button>
                            <Button x:Name="MaximizeButton" Style="{StaticResource WindowChromeButton}"
                                    Click="MaximizeButton_OnClick" ToolTip="Розгорнути">
                                <TextBlock x:Name="MaximizeIcon" Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="11"/>
                            </Button>
                            <Button Style="{StaticResource WindowCloseButton}"
                                    Click="CloseButton_OnClick" ToolTip="Закрити">
                                <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="11"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                
                <Border Grid.Row="1" Background="{StaticResource ContentScrim}" Padding="22,16,22,22">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        
                        <TabControl Grid.Row="0" Grid.RowSpan="2"
                                    Style="{StaticResource PillTabControl}"
                                    ItemContainerStyle="{StaticResource PillTabItem}">
                            <TabItem Header="Jordan Methods">
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="210"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    
                                    <Border Grid.Column="0" Background="{StaticResource CardSurface}"
                                            BorderBrush="{StaticResource CardStroke}" BorderThickness="1"
                                            CornerRadius="18" Padding="12,16" VerticalAlignment="Stretch"
                                            Margin="0,0,16,0">
                                        <StackPanel VerticalAlignment="Top">
                                            <TextBlock Text="МОДУЛІ" FontFamily="{StaticResource UiFont}"
                                                       FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMuted}"
                                                       Margin="14,4,0,10"/>
                                            <Button Command="{Binding SelectInverseCommand}" ToolTip="Inverse Matrix">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource SidebarItem}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedIndex}" Value="0">
                                                                <Setter Property="Tag" Value="Active"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                                                               VerticalAlignment="Center" Margin="0,0,12,0"
                                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                                    <TextBlock Text="Inverse" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Command="{Binding SelectRankCommand}" ToolTip="Matrix Rank">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource SidebarItem}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedIndex}" Value="1">
                                                                <Setter Property="Tag" Value="Active"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE734;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                                                               VerticalAlignment="Center" Margin="0,0,12,0"
                                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                                    <TextBlock Text="Rank" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Command="{Binding SelectLinearSystemCommand}" ToolTip="Linear System">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource SidebarItem}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedIndex}" Value="2">
                                                                <Setter Property="Tag" Value="Active"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                                                               VerticalAlignment="Center" Margin="0,0,12,0"
                                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                                    <TextBlock Text="Solve" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="1">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <ContentControl Content="{Binding CurrentViewModel}" Margin="0,4,0,16"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </TabItem>

                            <TabItem Header="Simplex">
                                <Border Margin="0,4,0,0">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <views:SimplexView DataContext="{Binding SimplexViewModel}" Margin="0,4,0,16"/>
                                    </ScrollViewer>
                                </Border>
                            </TabItem>

                            <TabItem Header="Gomori">
                                <Border Margin="0,4,0,0">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <views:GomoryView DataContext="{Binding GomoryViewModel}" Margin="0,4,0,16"/>
                                    </ScrollViewer>
                                </Border>
                            </TabItem>
                        </TabControl>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
