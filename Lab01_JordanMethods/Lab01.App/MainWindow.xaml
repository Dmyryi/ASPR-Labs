<Window x:Class="Lab01.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Lab01.App"
        xmlns:vm="clr-namespace:Lab01.App.ViewModels"
        xmlns:views="clr-namespace:Lab01.App.Views"
        mc:Ignorable="d"
        Title="Lab01 — Jordan Methods" Height="800" Width="1180"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <!-- Фон: изображение + затемнение для читаемости UI -->
        <ImageBrush x:Key="WindowBackground" ImageSource="/Lab01.App;component/wmremove-transformed.png"
                    Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center"/>
        <DataTemplate DataType="{x:Type vm:InverseMatrixViewModel}">
            <views:InverseMatrixView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RankViewModel}">
            <views:RankView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:LinearSystemViewModel}">
            <views:LinearSystemView/>
        </DataTemplate>
        <!-- Sidebar: transparent, active icon with glow -->
        <Style x:Key="SidebarItem" TargetType="Button">
            <Setter Property="Height" Value="52"/>
            <Setter Property="Margin" Value="0,6"/>
            <Setter Property="Foreground" Value="#A0A0A8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="14" Background="{TemplateBinding Background}" Margin="0,0,12,0">
                            <Border.Effect>
                                <DropShadowEffect x:Name="glow" BlurRadius="0" Color="Transparent" Opacity="0"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#70FFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SidebarBtn0" TargetType="Button" BasedOn="{StaticResource SidebarItem}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedIndex}" Value="0">
                    <Setter Property="Background" Value="#70FFFFFF"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" CornerRadius="14" Background="#70FFFFFF" Margin="0,0,12,0">
                                    <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SidebarBtn1" TargetType="Button" BasedOn="{StaticResource SidebarItem}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedIndex}" Value="1">
                    <Setter Property="Background" Value="#70FFFFFF"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" CornerRadius="14" Background="#70FFFFFF" Margin="0,0,12,0">
                                    <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SidebarBtn2" TargetType="Button" BasedOn="{StaticResource SidebarItem}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedIndex}" Value="2">
                    <Setter Property="Background" Value="#70FFFFFF"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" CornerRadius="14" Background="#70FFFFFF" Margin="0,0,12,0">
                                    <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <ControlTemplate x:Key="CloseButtonTemplate" TargetType="Button">
            <Border x:Name="bg" CornerRadius="18" Background="#20FFFFFF">
                <TextBlock x:Name="icon" Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                           Foreground="#B0B0B8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="bg" Property="Background" Value="#E81123"/>
                    <Setter TargetName="icon" Property="Foreground" Value="White"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </Window.Resources>

    <!-- Rounded window with photo background, без границ -->
    <Border x:Name="WindowBorder" CornerRadius="28" BorderThickness="0"
            Background="{StaticResource WindowBackground}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top bar (draggable), полупрозрачная чтобы фото просвечивало -->
            <Border Grid.Row="0" Padding="28,20" CornerRadius="28,28,0,0" MouseLeftButtonDown="TopBar_OnMouseLeftButtonDown"
                    Background="#50000000">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="#70FFFFFF" CornerRadius="14" Padding="20,14" VerticalAlignment="Center" HorizontalAlignment="Left"
                            BorderThickness="0">
                        <TextBlock Text="Welcome" FontFamily="Inter, Segoe UI Variable Display, Segoe UI" FontSize="17" FontWeight="Bold" 
                                   Foreground="White" VerticalAlignment="Center"/>
                    </Border>
                    <Button Grid.Column="1" Width="40" Height="40" Padding="0" Margin="20,0,0,0" Click="CloseButton_OnClick" Cursor="Hand"
                            Template="{StaticResource CloseButtonTemplate}"/>
                </Grid>
            </Border>

            <!-- Main: sidebar + content -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Sidebar: transparent, no dark background -->
                <Border Grid.Column="0" Background="Transparent" Padding="16,24" VerticalAlignment="Stretch">
                    <StackPanel VerticalAlignment="Top">
                        <Button Command="{Binding SelectInverseCommand}" Style="{StaticResource SidebarBtn0}" ToolTip="Inverse Matrix">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="24" VerticalAlignment="Center" Margin="0,0,14,0"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <TextBlock Text="Inverse" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding SelectRankCommand}" Style="{StaticResource SidebarBtn1}" ToolTip="Matrix Rank">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE734;" FontFamily="Segoe MDL2 Assets" FontSize="24" VerticalAlignment="Center" Margin="0,0,14,0"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <TextBlock Text="Rank" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding SelectLinearSystemCommand}" Style="{StaticResource SidebarBtn2}" ToolTip="Linear System">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="24" VerticalAlignment="Center" Margin="0,0,14,0"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                <TextBlock Text="Solve" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Content area: фото просвечивает сквозь лёгкий оверлей -->
                <Border Grid.Column="1" Margin="0" Padding="32" Background="#30000000">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ContentControl Content="{Binding CurrentViewModel}" Margin="0,8,0,24"/>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
