<UserControl x:Class="Lab01.App.Views.MultiCriteriaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="920">
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14" Orientation="Horizontal">
            <TextBlock Text="Багатокритеріальна оптимізація" Style="{StaticResource TitleText}" VerticalAlignment="Center"/>
            <Border Margin="14,0,0,0" Padding="10,4" CornerRadius="8"
                    Background="{StaticResource CardSurface}" BorderBrush="{StaticResource CardStroke}" BorderThickness="1"
                    VerticalAlignment="Center">
                <TextBlock Text="Ігровий підхід (рис. 1)" Style="{StaticResource SubtitleText}" FontWeight="SemiBold" FontSize="13"/>
            </Border>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="260" MaxWidth="400"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*" MinWidth="340"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="Цільові функції (кожна з max або min):" Style="{StaticResource SectionHeader}" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding ObjectivesText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource InputTextBox}"
                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100" FontFamily="Consolas" FontSize="14" Margin="0,0,0,12"/>

                    <TextBlock Text="Обмеження:" Style="{StaticResource SectionHeader}" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding ConstraintsText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource InputTextBox}"
                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="120" FontFamily="Consolas" FontSize="14"/>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Command="{Binding SolveCommand}" Style="{StaticResource ActionButton}" Padding="18,10" Margin="0,0,10,0">
                            <TextBlock Text="Знайти оптимальний розв'язок" FontWeight="SemiBold" FontSize="13"/>
                        </Button>
                        <Button Command="{Binding GenerateProtocolCommand}" Style="{StaticResource SecondaryButton}" Padding="16,10">
                            <TextBlock Text="Згенерувати протокол" FontWeight="SemiBold" FontSize="13"/>
                        </Button>
                    </StackPanel>
                    <TextBlock Text="{Binding SavedProtocolPath, Mode=OneWay}" Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                    <TextBlock Text="Коефіцієнти цільових функцій:" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding CoefficientsDisplay, Mode=OneWay}" Style="{StaticResource InputTextBox}" IsReadOnly="True"
                             AcceptsReturn="True" MinHeight="56" FontFamily="Consolas" Margin="0,0,0,8"/>

                    <TextBlock Text="Оптимальні вектори Xᵢ*:" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding OptimalVectorsDisplay, Mode=OneWay}" Style="{StaticResource InputTextBox}" IsReadOnly="True"
                             AcceptsReturn="True" MinHeight="56" FontFamily="Consolas" Margin="0,0,0,8"/>

                    <TextBlock Text="Матриця неоптимальностей Q:" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding SuboptimalityDisplay, Mode=OneWay}" Style="{StaticResource InputTextBox}" IsReadOnly="True"
                             AcceptsReturn="True" MinHeight="56" FontFamily="Consolas" Margin="0,0,0,8"/>

                    <TextBlock Text="Матриця гри G:" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding GameMatrixDisplay, Mode=OneWay}" Style="{StaticResource InputTextBox}" IsReadOnly="True"
                             AcceptsReturn="True" MinHeight="56" FontFamily="Consolas" Margin="0,0,0,8"/>

                    <TextBlock Text="Вагові коефіцієнти λ:" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding WeightsDisplay, Mode=OneWay}" Style="{StaticResource InputTextBox}" IsReadOnly="True" FontFamily="Consolas" Margin="0,0,0,8"/>

                    <TextBlock Text="Компромісний розв'язок:" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding CompromiseDisplay, Mode=OneWay}" Style="{StaticResource InputTextBox}" IsReadOnly="True" FontFamily="Consolas" Margin="0,0,0,8"/>

                    <TextBlock Text="{Binding SummaryDisplay, Mode=OneWay}" Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                    <StackPanel Orientation="Horizontal">
                        <Button Command="{Binding LoadExample1Command}" Style="{StaticResource SecondaryButton}" Padding="12,8" Margin="0,0,8,0">
                            <TextBlock Text="Тест 1" FontSize="12"/>
                        </Button>
                        <Button Command="{Binding LoadExample2Command}" Style="{StaticResource SecondaryButton}" Padding="12,8" Margin="0,0,8,0">
                            <TextBlock Text="Тест 2" FontSize="12"/>
                        </Button>
                        <Button Command="{Binding LoadVariant10Command}" Style="{StaticResource SecondaryButton}" Padding="12,8">
                            <TextBlock Text="Варіант 10" FontSize="12"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
