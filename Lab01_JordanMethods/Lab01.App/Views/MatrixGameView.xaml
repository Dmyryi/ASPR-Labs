<UserControl x:Class="Lab01.App.Views.MatrixGameView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="906">
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14" Orientation="Horizontal">
            <TextBlock Text="Матричні ігри" Style="{StaticResource TitleText}" VerticalAlignment="Center"/>
            <Border Margin="14,0,0,0" Padding="10,4" CornerRadius="8"
                    Background="{StaticResource CardSurface}" BorderBrush="{StaticResource CardStroke}" BorderThickness="1"
                    VerticalAlignment="Center">
                <TextBlock Text="A — виграш гравця A (рядки)" Style="{StaticResource SubtitleText}" FontWeight="SemiBold" FontSize="13"/>
            </Border>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="260" MaxWidth="420"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*" MinWidth="320"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="Матриця гри:" Style="{StaticResource SectionHeader}" Margin="0,0,0,6"/>
                    <TextBlock Text="Рядки — стратегії 1-го гравця (A), стовпці — 2-го (B)." Style="{StaticResource HintText}" Margin="0,0,0,8"/>
                    <TextBox Text="{Binding MatrixText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource InputTextBox}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MinHeight="160"
                             FontFamily="Consolas"
                             FontSize="14"/>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <StackPanel Width="120" Margin="0,0,16,0">
                            <TextBlock Text="К-ть партій" Style="{StaticResource HintText}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding RoundsText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBox}"/>
                        </StackPanel>
                        <Button Command="{Binding SimulateCommand}" Style="{StaticResource SecondaryButton}" Padding="16,10" VerticalAlignment="Bottom">
                            <TextBlock Text="Змоделювати гру…" FontWeight="SemiBold" FontSize="13"/>
                        </Button>
                    </StackPanel>

                    <TextBlock Text="Змішані стратегії 1-го гравця" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding RowStrategyDisplay, Mode=OneWay}"
                             Style="{StaticResource InputTextBox}"
                             IsReadOnly="True"
                             FontFamily="Consolas"
                             FontSize="14"
                             Margin="0,0,0,14"/>

                    <TextBlock Text="Змішані стратегії 2-го гравця" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding ColumnStrategyDisplay, Mode=OneWay}"
                             Style="{StaticResource InputTextBox}"
                             IsReadOnly="True"
                             FontFamily="Consolas"
                             FontSize="14"
                             Margin="0,0,0,14"/>

                    <TextBlock Text="Ціна гри" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding GameValueDisplay, Mode=OneWay}"
                             Style="{StaticResource InputTextBox}"
                             IsReadOnly="True"
                             FontFamily="Consolas"
                             FontSize="14"
                             Margin="0,0,0,16"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Button Command="{Binding SolveCommand}" Style="{StaticResource ActionButton}" Padding="18,10" Margin="0,0,10,0">
                            <TextBlock Text="Знайти розв’язок гри" FontWeight="SemiBold" FontSize="13"/>
                        </Button>
                        <Button Command="{Binding LoadExampleCommand}" Style="{StaticResource SecondaryButton}" Padding="12,8" Margin="0,0,8,0">
                            <TextBlock Text="Приклад 3×3" FontSize="12"/>
                        </Button>
                        <Button Command="{Binding LoadVariant1Command}" Style="{StaticResource SecondaryButton}" Padding="12,8">
                            <TextBlock Text="Варіант 10 (A1)" FontSize="12"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
