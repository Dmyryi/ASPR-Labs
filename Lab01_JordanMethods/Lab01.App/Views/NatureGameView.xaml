<UserControl x:Class="Lab01.App.Views.NatureGameView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="920">
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14" Orientation="Horizontal">
            <TextBlock Text="Матричні ігри з природою" Style="{StaticResource TitleText}" VerticalAlignment="Center"/>
            <Border Margin="14,0,0,0" Padding="10,4" CornerRadius="8"
                    Background="{StaticResource CardSurface}" BorderBrush="{StaticResource CardStroke}" BorderThickness="1"
                    VerticalAlignment="Center">
                <TextBlock Text="U — матриця корисності; рядки A, стовпці — стани природи" Style="{StaticResource SubtitleText}" FontWeight="SemiBold" FontSize="13"/>
            </Border>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="280" MaxWidth="440"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*" MinWidth="320"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="Матриця корисності результатів U:" Style="{StaticResource SectionHeader}" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding MatrixText, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource InputTextBox}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MinHeight="180"
                             FontFamily="Consolas"
                             FontSize="14"/>

                    <TextBlock Text="Матриця ризику (Севідж)" Style="{StaticResource SectionHeader}" Margin="0,16,0,6"/>
                    <TextBox Text="{Binding RegretMatrixDisplay, Mode=OneWay}"
                             Style="{StaticResource InputTextBox}"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MinHeight="100"
                             FontFamily="Consolas"
                             FontSize="13"/>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Коефіцієнт γ (Гурвіц)" Style="{StaticResource HintText}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding GammaText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBox}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Ймовірності станів природи (p₁ … pₘ)" Style="{StaticResource HintText}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding ProbabilitiesText, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource InputTextBox}"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Command="{Binding SolveCommand}" Style="{StaticResource ActionButton}" Padding="18,10" Margin="0,0,10,0">
                            <TextBlock Text="Знайти оптимальні стратегії" FontWeight="SemiBold" FontSize="13"/>
                        </Button>
                        <Button Command="{Binding GenerateProtocolCommand}" Style="{StaticResource SecondaryButton}" Padding="16,10">
                            <TextBlock Text="Згенерувати протокол" FontWeight="SemiBold" FontSize="13"/>
                        </Button>
                    </StackPanel>
                    <TextBlock Text="{Binding SavedProtocolPath, Mode=OneWay}"
                               Style="{StaticResource HintText}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,16"/>

                    <TextBlock Text="Критерій Вальда" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding WaldDisplay, Mode=OneWay}" Style="{StaticResource InputTextBox}" IsReadOnly="True" Margin="0,0,0,10"/>

                    <TextBlock Text="Критерій максимаксу" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding MaximaxDisplay, Mode=OneWay}" Style="{StaticResource InputTextBox}" IsReadOnly="True" Margin="0,0,0,10"/>

                    <TextBlock Text="Критерій Гурвіца" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding HurwiczDisplay, Mode=OneWay}" Style="{StaticResource InputTextBox}" IsReadOnly="True" Margin="0,0,0,10"/>

                    <TextBlock Text="Критерій Байєса" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding BayesDisplay, Mode=OneWay}" Style="{StaticResource InputTextBox}" IsReadOnly="True" Margin="0,0,0,10"/>

                    <TextBlock Text="Критерій Севіджа" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding SavageDisplay, Mode=OneWay}" Style="{StaticResource InputTextBox}" IsReadOnly="True" Margin="0,0,0,10"/>

                    <TextBlock Text="Критерій Лапласа" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding LaplaceDisplay, Mode=OneWay}" Style="{StaticResource InputTextBox}" IsReadOnly="True" Margin="0,0,0,10"/>

                    <TextBlock Text="Найчастіші стратегії" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding FrequentDisplay, Mode=OneWay}" Style="{StaticResource InputTextBox}" IsReadOnly="True" Margin="0,0,0,14"/>

                    <StackPanel Orientation="Horizontal">
                        <Button Command="{Binding LoadExample1Command}" Style="{StaticResource SecondaryButton}" Padding="12,8" Margin="0,0,8,0">
                            <TextBlock Text="Тест 1 (методичка)" FontSize="12"/>
                        </Button>
                        <Button Command="{Binding LoadExample2Command}" Style="{StaticResource SecondaryButton}" Padding="12,8">
                            <TextBlock Text="Тест 2 (методичка)" FontSize="12"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
