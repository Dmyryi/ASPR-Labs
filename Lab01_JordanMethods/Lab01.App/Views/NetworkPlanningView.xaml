<UserControl x:Class="Lab01.App.Views.NetworkPlanningView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Lab01.App.Views"
             Loaded="NetworkPlanningView_OnLoaded">
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14" Orientation="Horizontal">
            <TextBlock Text="Сіткове планування" Style="{StaticResource TitleText}" VerticalAlignment="Center"/>
            <Border Margin="14,0,0,0" Padding="10,4" CornerRadius="8"
                    Background="{StaticResource CardSurface}" BorderBrush="{StaticResource CardStroke}" BorderThickness="1"
                    VerticalAlignment="Center">
                <TextBlock Text="Метод критичного шляху" Style="{StaticResource SubtitleText}" FontWeight="SemiBold" FontSize="13"/>
            </Border>
        </StackPanel>

        <Grid Grid.Row="1" MinHeight="480">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" MinWidth="300" MaxWidth="420"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*" MinWidth="420"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="Вхідні дані" Style="{StaticResource SectionHeader}" Margin="0,0,0,6"/>
                    <DataGrid ItemsSource="{Binding Tasks}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              HeadersVisibility="Column"
                              Margin="0,0,0,12"
                              MinHeight="220"
                              MaxHeight="360"
                              FontFamily="Consolas"
                              FontSize="13">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Робота" Binding="{Binding Id, UpdateSourceTrigger=PropertyChanged}" Width="52"/>
                            <DataGridTextColumn Header="Попередні" Binding="{Binding PredecessorsText, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                            <DataGridTextColumn Header="T" Binding="{Binding Duration, UpdateSourceTrigger=PropertyChanged}" Width="44"/>
                            <DataGridTextColumn Header="Люди" Binding="{Binding People, UpdateSourceTrigger=PropertyChanged}" Width="48"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Command="{Binding SolveCommand}" Style="{StaticResource ActionButton}" Padding="14,10" Margin="0,0,8,0">
                            <TextBlock Text="Розрахувати" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap" MaxWidth="140"/>
                        </Button>
                        <Button Command="{Binding GenerateProtocolCommand}" Style="{StaticResource SecondaryButton}" Padding="12,10">
                            <TextBlock Text="Протокол" FontWeight="SemiBold" FontSize="12"/>
                        </Button>
                    </StackPanel>
                    <TextBlock Text="{Binding SavedProtocolPath, Mode=OneWay}" Style="{StaticResource HintText}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                    <TextBlock Text="Результат" Style="{StaticResource SectionHeader}" Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="72"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Критичний шлях" Style="{StaticResource HintText}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding CriticalPathDisplay, Mode=OneWay}" Style="{StaticResource InputTextBox}" IsReadOnly="True" FontFamily="Consolas"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="T проєкту" Style="{StaticResource HintText}" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding DurationDisplay, Mode=OneWay}" Style="{StaticResource InputTextBox}" IsReadOnly="True" FontFamily="Consolas"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal">
                        <Button Command="{Binding LoadExample1Command}" Style="{StaticResource SecondaryButton}" Padding="10,7" Margin="0,0,6,0">
                            <TextBlock Text="Тест 1" FontSize="11"/>
                        </Button>
                        <Button Command="{Binding LoadExample2Command}" Style="{StaticResource SecondaryButton}" Padding="10,7" Margin="0,0,6,0">
                            <TextBlock Text="Тест 2" FontSize="11"/>
                        </Button>
                        <Button Command="{Binding LoadVariant10Command}" Style="{StaticResource SecondaryButton}" Padding="10,7">
                            <TextBlock Text="Вар. 10" FontSize="11"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Column="2"
                    Background="{StaticResource CardSurface}"
                    BorderBrush="{StaticResource CardStroke}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Графіки" Style="{StaticResource SectionHeader}" Margin="4,4,4,6"/>

                    <Border Grid.Row="1" Margin="4,0,4,8" Padding="8,6"
                            Background="#18FFFFFF" CornerRadius="10"
                            BorderBrush="{StaticResource CardStroke}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Command="{Binding SelectPreviousTaskCommand}" Style="{StaticResource SecondaryButton}" Padding="8,6" Margin="0,0,4,0" ToolTip="Попередня робота">
                                    <TextBlock Text="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                                </Button>
                                <Button Command="{Binding SelectNextTaskCommand}" Style="{StaticResource SecondaryButton}" Padding="8,6" ToolTip="Наступна робота">
                                    <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                                </Button>
                            </StackPanel>
                            <ComboBox Grid.Column="1" Margin="8,0"
                                      ItemsSource="{Binding TaskOptions}"
                                      SelectedItem="{Binding SelectedTask}"
                                      DisplayMemberPath="Title"
                                      MinWidth="120" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Command="{Binding ShiftEarlierCommand}" Style="{StaticResource SecondaryButton}" Padding="8,6" Margin="0,0,4,0" ToolTip="Раніше (у межах резерву)">
                                    <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                                </Button>
                                <Button Command="{Binding ShiftLaterCommand}" Style="{StaticResource SecondaryButton}" Padding="8,6" Margin="0,0,8,0" ToolTip="Пізніше (у межах резерву)">
                                    <TextBlock Text="&#xE72A;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                                </Button>
                                <Button Command="{Binding OptimizeScheduleCommand}" Style="{StaticResource ActionButton}" Padding="10,6" ToolTip="Оптимізувати завантаження">
                                    <TextBlock Text="Оптимізувати" FontSize="11" FontWeight="SemiBold"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <TextBlock Grid.Row="2" Text="{Binding ScheduleHint, Mode=OneWay}" Style="{StaticResource HintText}"
                               Margin="8,0,8,6" TextWrapping="Wrap"/>

                    <views:NetworkPlanningCharts x:Name="Charts" Grid.Row="3" MinHeight="360"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
