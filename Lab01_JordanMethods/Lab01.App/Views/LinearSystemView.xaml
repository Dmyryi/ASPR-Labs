<UserControl x:Class="Lab01.App.Views.LinearSystemView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,24">
            <StackPanel>
                <TextBlock Text="Linear System" Style="{StaticResource TitleText}" Margin="0,0,0,4"/>
                <TextBlock Text="Ax = B" FontSize="32" Foreground="#00D4AA" FontWeight="Light" Opacity="0.95"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <!-- Main cards: Matrix A + Vector B -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border Style="{StaticResource FeatureCard}" Margin="0,0,0,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0">
                                <TextBlock Text="Matrix A" Style="{StaticResource SectionHeader}"/>
                                <TextBlock Text="rows on new lines, numbers separated by spaces" 
                                           FontSize="12" Foreground="#8A8A94" Margin="0,-8,0,8"/>
                            </StackPanel>
                            <TextBox Grid.Row="1" Text="{Binding MatrixText, UpdateSourceTrigger=PropertyChanged}" 
                                     AcceptsReturn="True" Style="{StaticResource InputTextBox}"
                                     MinHeight="120" VerticalScrollBarVisibility="Auto" VerticalAlignment="Stretch"/>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0">
                                <TextBlock Text="Vector B" Style="{StaticResource SectionHeader}"/>
                                <TextBlock Text="numbers separated by spaces" 
                                           FontSize="12" Foreground="#8A8A94" Margin="0,-8,0,8"/>
                            </StackPanel>
                            <TextBox Grid.Row="1" Text="{Binding VectorText, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{StaticResource InputTextBox}" MinHeight="56"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Right panel: actions + result -->
            <StackPanel Grid.Column="2" VerticalAlignment="Stretch">
                <Border Style="{StaticResource SmallCard}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Actions" Style="{StaticResource SectionHeader}"/>
                        <Button Command="{Binding ComputeCommand}" Style="{StaticResource ActionButton}" 
                                HorizontalAlignment="Stretch" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Run" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding SaveProtocolCommand}" Style="{StaticResource SecondaryButton}" 
                                HorizontalAlignment="Stretch" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="Save Protocol" FontSize="14" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <TextBlock Text="{Binding Status}" Foreground="#8A8A94" FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource SmallCard}" VerticalAlignment="Stretch">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Result X" Style="{StaticResource SectionHeader}"/>
                        <TextBox Grid.Row="1" Text="{Binding ResultText, Mode=OneWay}" IsReadOnly="True"
                                 Style="{StaticResource InputTextBox}" Foreground="#00E676"
                                 MinHeight="100" VerticalScrollBarVisibility="Auto" 
                                 VerticalAlignment="Stretch" Margin="0,4,0,0"/>
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
