<UserControl x:Class="Lab01.App.Views.LinearSystemView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18" Orientation="Horizontal">
            <TextBlock Text="Linear System" Style="{StaticResource TitleText}" VerticalAlignment="Center"/>
            <Border Margin="14,0,0,0" Padding="10,4" CornerRadius="8"
                    Background="{StaticResource CardSurface}" BorderBrush="{StaticResource CardStroke}" BorderThickness="1"
                    VerticalAlignment="Center">
                <TextBlock Text="A·x = B" Style="{StaticResource SubtitleText}" FontWeight="SemiBold" FontSize="13"/>
            </Border>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border Style="{StaticResource FeatureCard}" Margin="0,0,0,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Matrix A" Style="{StaticResource SectionHeader}"/>
                            <TextBlock Grid.Row="1" Text="рядки на нових лініях, числа через пробіл"
                                       Style="{StaticResource HintText}"/>
                            <TextBox Grid.Row="2" Text="{Binding MatrixText, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" Style="{StaticResource InputTextBox}"
                                     Tag="5 -3 7&#x0a;-1 4 -2&#x0a;3 -1 2"
                                     MinHeight="140" VerticalScrollBarVisibility="Auto" VerticalAlignment="Stretch"/>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource CardBorder}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Vector B" Style="{StaticResource SectionHeader}"/>
                            <TextBlock Grid.Row="1" Text="числа через пробіл" Style="{StaticResource HintText}"/>
                            <TextBox Grid.Row="2" Text="{Binding VectorText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource InputTextBox}"
                                     Tag="13 13 12"
                                     MinHeight="56"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Column="2" VerticalAlignment="Stretch">
                <Border Style="{StaticResource SmallCard}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Actions" Style="{StaticResource SectionHeader}"/>
                        <Button Command="{Binding ComputeCommand}" Style="{StaticResource ActionButton}"
                                HorizontalAlignment="Stretch" Margin="0,0,0,10">
                            <TextBlock Text="Run" VerticalAlignment="Center"/>
                        </Button>
                        <Button Command="{Binding SaveProtocolCommand}" Style="{StaticResource SecondaryButton}"
                                HorizontalAlignment="Stretch" Margin="0,0,0,4">
                            <TextBlock Text="Save Protocol" VerticalAlignment="Center"/>
                        </Button>
                        <TextBlock Text="{Binding Status}" Style="{StaticResource StatusText}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource ResultCard}" VerticalAlignment="Stretch">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Result X" Style="{StaticResource SectionHeader}"/>
                        <TextBox Grid.Row="1" Text="{Binding ResultText, Mode=OneWay}" IsReadOnly="True"
                                 Style="{StaticResource InputTextBox}"
                                 Tag="вектор X з'явиться тут"
                                 MinHeight="100" VerticalScrollBarVisibility="Auto"
                                 VerticalAlignment="Stretch" Margin="0,4,0,0"/>
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
