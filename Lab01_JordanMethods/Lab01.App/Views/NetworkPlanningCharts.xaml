<UserControl x:Class="Lab01.App.Views.NetworkPlanningCharts"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             SizeChanged="NetworkPlanningCharts_OnSizeChanged">
    <TabControl Style="{StaticResource PillTabControl}" ItemContainerStyle="{StaticResource PillTabItem}">
        <TabItem Header="Календарний графік">
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          CanContentScroll="False"
                          Padding="4">
                <Canvas x:Name="GanttCanvas" Background="#08FFFFFF"/>
            </ScrollViewer>
        </TabItem>
        <TabItem Header="Графік завантаження">
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          CanContentScroll="False"
                          Padding="4">
                <Canvas x:Name="ResourceCanvas" Background="#08FFFFFF"/>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</UserControl>
