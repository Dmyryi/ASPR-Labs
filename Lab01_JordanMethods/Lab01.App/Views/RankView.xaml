<UserControl x:Class="Lab01.App.Views.RankView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18" Orientation="Horizontal">
            <TextBlock Text="Matrix Rank" Style="{StaticResource TitleText}" VerticalAlignment="Center"/>
            <Border Margin="14,0,0,0" Padding="10,4" CornerRadius="8"
                    Background="{StaticResource CardSurface}" BorderBrush="{StaticResource CardStroke}" BorderThickness="1"
                    VerticalAlignment="Center">
                <TextBlock Text="r(A)" Style="{StaticResource SubtitleText}" FontWeight="SemiBold" FontSize="13"/>
            </Border>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource FeatureCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Input Matrix" Style="{StaticResource SectionHeader}"/>
                    <TextBlock Grid.Row="1" Text="рядки на нових лініях, числа через пробіл"
                               Style="{StaticResource HintText}"/>
                    <TextBox Grid.Row="2" Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" Style="{StaticResource InputTextBox}"
                             Tag="6 2 5 -3 4&#x0a;-1 1 0 0 1&#x0a;1 2 1 1 1"
                             MinHeight="160" VerticalScrollBarVisibility="Auto" VerticalAlignment="Stretch"/>
                </Grid>
            </Border>

            <StackPanel Grid.Column="2" VerticalAlignment="Stretch">
                <Border Style="{StaticResource SmallCard}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Actions" Style="{StaticResource SectionHeader}"/>
                        <Button Command="{Binding ComputeCommand}" Style="{StaticResource ActionButton}"
                                HorizontalAlignment="Stretch" Margin="0,0,0,10">
                            <TextBlock Text="Run Computation" VerticalAlignment="Center"/>
                        </Button>
                        <Button Command="{Binding SaveProtocolCommand}" Style="{StaticResource SecondaryButton}"
                                HorizontalAlignment="Stretch" Margin="0,0,0,4">
                            <TextBlock Text="Save Protocol" VerticalAlignment="Center"/>
                        </Button>
                        <TextBlock Text="{Binding Status}" Style="{StaticResource StatusText}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource ResultCard}" VerticalAlignment="Stretch">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Result" Style="{StaticResource SectionHeader}"/>
                        <TextBlock Grid.Row="1" Text="{Binding ResultText}" Style="{StaticResource ResultTextNeon}"
                                   VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,8,0,0"/>
                    </Grid>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
