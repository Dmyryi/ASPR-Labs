<UserControl x:Class="Lab01.App.Views.SimplexView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,24">
            <StackPanel>
                <TextBlock Text="Simplex Optimization" Style="{StaticResource TitleText}" Margin="0,0,0,4"/>
                <TextBlock Text="Min / Max search by constraints" FontSize="26" Foreground="#00D4AA" FontWeight="Light" Opacity="0.95"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*" MinWidth="300"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border Style="{StaticResource FeatureCard}" Margin="0,0,0,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0">
                                <TextBlock Text="Objective Function Z" Style="{StaticResource SectionHeader}"/>
                                <TextBlock Text="example: x1 + 2x2 - x3 - x4"
                                           FontSize="13" Foreground="#FFF2F2F5" Margin="0,-8,0,8"/>
                            </StackPanel>
                            <TextBox Grid.Row="1" Text="{Binding ObjectiveText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource InputTextBox}" MinHeight="56"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CardBorder}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Background="#35FFFFFF" CornerRadius="10" Padding="10" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Command="{Binding LoadExampleMaxCommand}" Style="{StaticResource SecondaryButton}" Padding="10,8">
                                        <TextBlock Text="Load max example" FontSize="12"/>
                                    </Button>
                                    <Button Grid.Column="2" Command="{Binding LoadExampleMinCommand}" Style="{StaticResource SecondaryButton}" Padding="10,8">
                                        <TextBlock Text="Load min example" FontSize="12"/>
                                    </Button>
                                </Grid>
                            </Border>

                            <StackPanel Grid.Row="1">
                                <TextBlock Text="Constraints" Style="{StaticResource SectionHeader}"/>
                                <TextBlock Text="one per line, use &lt;=, &gt;= or =, example: x1 + x2 - x3 - 2x4 &lt;= 6"
                                           FontSize="13" Foreground="#FFF2F2F5" Margin="0,-8,0,8" TextWrapping="Wrap"/>
                            </StackPanel>
                            <TextBox Grid.Row="2" Text="{Binding ConstraintsText, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" Style="{StaticResource InputTextBox}" MinHeight="170"
                                     VerticalScrollBarVisibility="Auto" VerticalAlignment="Stretch"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <TabControl Grid.Column="2" Background="Transparent" BorderThickness="0">
                <TabItem Header="Maximization">
                    <StackPanel Margin="0,8,0,0" VerticalAlignment="Stretch">
                        <Border Style="{StaticResource SmallCard}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Actions" Style="{StaticResource SectionHeader}"/>
                                <Button Command="{Binding SolveMaxCommand}" Style="{StaticResource ActionButton}"
                                        HorizontalAlignment="Stretch" Margin="0,0,0,8">
                                    <TextBlock Text="Run Maximization" FontSize="14" VerticalAlignment="Center"/>
                                </Button>
                                <Button Command="{Binding SaveProtocolCommand}" Style="{StaticResource SecondaryButton}"
                                        HorizontalAlignment="Stretch" Margin="0,0,0,8">
                                    <TextBlock Text="Save Protocol" FontSize="14" VerticalAlignment="Center"/>
                                </Button>
                                <TextBlock Text="{Binding Status}" Foreground="#FFF2F2F5" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource ResultCard}" VerticalAlignment="Stretch">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Simplex Result" Style="{StaticResource SectionHeader}"/>
                                <TextBox Grid.Row="1" Text="{Binding ResultText, Mode=OneWay}" IsReadOnly="True"
                                         Style="{StaticResource InputTextBox}" Foreground="#FFFFFF"
                                         MinHeight="130" VerticalScrollBarVisibility="Auto"
                                         VerticalAlignment="Stretch" Margin="0,4,0,0"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </TabItem>

                <TabItem Header="Minimization">
                    <StackPanel Margin="0,8,0,0" VerticalAlignment="Stretch">
                        <Border Style="{StaticResource SmallCard}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Actions" Style="{StaticResource SectionHeader}"/>
                                <Button Command="{Binding SolveMinCommand}" Style="{StaticResource ActionButton}"
                                        HorizontalAlignment="Stretch" Margin="0,0,0,8">
                                    <TextBlock Text="Run Minimization" FontSize="14" VerticalAlignment="Center"/>
                                </Button>
                                <Button Command="{Binding SaveProtocolCommand}" Style="{StaticResource SecondaryButton}"
                                        HorizontalAlignment="Stretch" Margin="0,0,0,8">
                                    <TextBlock Text="Save Protocol" FontSize="14" VerticalAlignment="Center"/>
                                </Button>
                                <TextBlock Text="{Binding Status}" Foreground="#FFF2F2F5" FontSize="12" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource ResultCard}" VerticalAlignment="Stretch">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Simplex Result" Style="{StaticResource SectionHeader}"/>
                                <TextBox Grid.Row="1" Text="{Binding ResultText, Mode=OneWay}" IsReadOnly="True"
                                         Style="{StaticResource InputTextBox}" Foreground="#FFFFFF"
                                         MinHeight="130" VerticalScrollBarVisibility="Auto"
                                         VerticalAlignment="Stretch" Margin="0,4,0,0"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</UserControl>
