<UserControl x:Class="Lab01.App.Views.SimplexView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18" Orientation="Horizontal">
            <TextBlock Text="Simplex Optimization" Style="{StaticResource TitleText}" VerticalAlignment="Center"/>
            <Border Margin="14,0,0,0" Padding="10,4" CornerRadius="8"
                    Background="{StaticResource CardSurface}" BorderBrush="{StaticResource CardStroke}" BorderThickness="1"
                    VerticalAlignment="Center">
                <TextBlock Text="Min / Max" Style="{StaticResource SubtitleText}" FontWeight="SemiBold" FontSize="13"/>
            </Border>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*" MinWidth="320"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border Style="{StaticResource FeatureCard}" Margin="0,0,0,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Objective Function Z" Style="{StaticResource SectionHeader}"/>
                            <TextBlock Grid.Row="1" Text="приклад: x1 + 2x2 - x3 - x4" Style="{StaticResource HintText}"/>
                            <TextBox Grid.Row="2" Text="{Binding ObjectiveText, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource InputTextBox}"
                                     Tag="x1 + 2x2 - x3 - x4"
                                     MinHeight="56"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CardBorder}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Command="{Binding LoadExample1Command}"
                                        Style="{StaticResource SecondaryButton}" Padding="12,8">
                                    <TextBlock Text="Load example 1" FontSize="12"/>
                                </Button>
                                <Button Grid.Column="2" Command="{Binding LoadExample2Command}"
                                        Style="{StaticResource SecondaryButton}" Padding="12,8">
                                    <TextBlock Text="Load example 2" FontSize="12"/>
                                </Button>
                            </Grid>

                            <TextBlock Grid.Row="1" Text="Constraints" Style="{StaticResource SectionHeader}"/>
                            <TextBlock Grid.Row="2"
                                       Text="одне на рядок, оператори: &lt;=, &gt;=, =. Приклад: x1 + x2 - x3 - 2x4 &lt;= 6"
                                       Style="{StaticResource HintText}"/>
                            <TextBox Grid.Row="3" Text="{Binding ConstraintsText, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True" Style="{StaticResource InputTextBox}"
                                     Tag="x1 + x2 - x3 - 2x4 &lt;= 6&#x0a;x1 + x2 + x3 - x4 &gt;= 5&#x0a;2x1 - x2 + 3x3 + 4x4 &lt;= 10"
                                     MinHeight="180" VerticalScrollBarVisibility="Auto" VerticalAlignment="Stretch"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <TabControl Grid.Column="2" Style="{StaticResource PillTabControl}"
                        ItemContainerStyle="{StaticResource PillTabItem}">
                <TabItem Header="Maximization">
                    <StackPanel Margin="0,4,0,0">
                        <Border Style="{StaticResource SmallCard}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Options" Style="{StaticResource SectionHeader}"/>
                                <CheckBox IsChecked="{Binding UseZeroRowElimination}"
                                          Style="{StaticResource ModernCheckBox}"
                                          Content="Use zero row elimination"
                                          Margin="0,0,0,16"/>
                                <TextBlock Text="Actions" Style="{StaticResource SectionHeader}"/>
                                <Button Command="{Binding SolveMaxCommand}" Style="{StaticResource ActionButton}"
                                        HorizontalAlignment="Stretch" Margin="0,0,0,10">
                                    <TextBlock Text="Run Maximization" VerticalAlignment="Center"/>
                                </Button>
                                <Button Command="{Binding SaveProtocolCommand}" Style="{StaticResource SecondaryButton}"
                                        HorizontalAlignment="Stretch" Margin="0,0,0,4">
                                    <TextBlock Text="Save Protocol" VerticalAlignment="Center"/>
                                </Button>
                                <TextBlock Text="{Binding Status}" Style="{StaticResource StatusText}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource ResultCard}" VerticalAlignment="Stretch">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Simplex Result" Style="{StaticResource SectionHeader}"/>
                                <TextBox Grid.Row="1" Text="{Binding ResultText, Mode=OneWay}" IsReadOnly="True"
                                         Style="{StaticResource InputTextBox}"
                                         Tag="результат симплекс-методу"
                                         MinHeight="140" VerticalScrollBarVisibility="Auto"
                                         VerticalAlignment="Stretch" Margin="0,4,0,0"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </TabItem>

                <TabItem Header="Minimization">
                    <StackPanel Margin="0,4,0,0">
                        <Border Style="{StaticResource SmallCard}" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Actions" Style="{StaticResource SectionHeader}"/>
                                <Button Command="{Binding SolveMinCommand}" Style="{StaticResource ActionButton}"
                                        HorizontalAlignment="Stretch" Margin="0,0,0,10">
                                    <TextBlock Text="Run Minimization" VerticalAlignment="Center"/>
                                </Button>
                                <Button Command="{Binding SaveProtocolCommand}" Style="{StaticResource SecondaryButton}"
                                        HorizontalAlignment="Stretch" Margin="0,0,0,4">
                                    <TextBlock Text="Save Protocol" VerticalAlignment="Center"/>
                                </Button>
                                <TextBlock Text="{Binding Status}" Style="{StaticResource StatusText}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource ResultCard}" VerticalAlignment="Stretch">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Simplex Result" Style="{StaticResource SectionHeader}"/>
                                <TextBox Grid.Row="1" Text="{Binding ResultText, Mode=OneWay}" IsReadOnly="True"
                                         Style="{StaticResource InputTextBox}"
                                         Tag="результат симплекс-методу"
                                         MinHeight="140" VerticalScrollBarVisibility="Auto"
                                         VerticalAlignment="Stretch" Margin="0,4,0,0"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</UserControl>
