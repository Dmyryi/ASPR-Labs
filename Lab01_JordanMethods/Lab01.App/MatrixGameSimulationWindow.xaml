<Window x:Class="Lab01.App.MatrixGameSimulationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Моделювання матричної гри (табл. 6.1)"
        Height="720" Width="1100"
        MinHeight="480" MinWidth="800"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource ContentScrim}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DataGrid x:Name="ProtocolGrid"
                  Grid.Row="0"
                  ItemsSource="{Binding Rows}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserReorderColumns="False"
                  HeadersVisibility="Column"
                  SelectionMode="Single"
                  GridLinesVisibility="Horizontal"
                  RowHeight="28"
                  FontFamily="Segoe UI"
                  FontSize="13"
                  Margin="0,0,0,12"
                  BorderBrush="{StaticResource CardStroke}"
                  BorderThickness="1"
                  Background="{StaticResource CardSurface}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="№ партії" Binding="{Binding Round}" Width="72"/>
                <DataGridTextColumn Header="Випадкове число гравця А" Binding="{Binding RandomRowPlayer}" Width="*"/>
                <DataGridTextColumn Header="Стратегія гравця А" Binding="{Binding StrategyRowPlayer}" Width="100"/>
                <DataGridTextColumn Header="Випадкове число гравця В" Binding="{Binding RandomColumnPlayer}" Width="*"/>
                <DataGridTextColumn Header="Стратегія гравця В" Binding="{Binding StrategyColumnPlayer}" Width="100"/>
                <DataGridTextColumn Header="Виграш А" Binding="{Binding PayoffRowPlayer}" Width="88"/>
                <DataGridTextColumn Header="Накопичений виграш А" Binding="{Binding AccumulatedPayoffRowPlayer}" Width="*"/>
                <DataGridTextColumn Header="Середній виграш А (ціна гри)" Binding="{Binding AveragePayoffRowPlayer}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="1" Padding="14,12" CornerRadius="12"
                Background="{StaticResource CardSurface}" BorderBrush="{StaticResource CardStroke}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="220"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Змішані стратегії 1-го гравця (теорія)" Style="{StaticResource HintText}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding TheoreticalRowStrategies, Mode=OneWay}" IsReadOnly="True"
                             Style="{StaticResource InputTextBox}" FontFamily="Consolas" FontSize="13"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Змішані стратегії 2-го гравця (теорія)" Style="{StaticResource HintText}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding TheoreticalColumnStrategies, Mode=OneWay}" IsReadOnly="True"
                             Style="{StaticResource InputTextBox}" FontFamily="Consolas" FontSize="13"/>
                </StackPanel>
                <StackPanel Grid.Column="4" VerticalAlignment="Top">
                    <TextBlock Text="Ціна гри (теорія)" Style="{StaticResource HintText}" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding TheoreticalGameValue, Mode=OneWay}" IsReadOnly="True"
                             Style="{StaticResource InputTextBox}" FontFamily="Consolas" FontSize="16" FontWeight="SemiBold"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
